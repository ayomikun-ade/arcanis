# Arcanis — environment variables
#
# Copy this file to .env.local and fill in real values.

# WhisperBox backend base URL. The browser hits this directly for messaging
# endpoints (REST + WebSocket). The Next.js auth proxy in /api/auth/* also
# forwards register/login/refresh/logout to this host.
NEXT_PUBLIC_API_BASE_URL=https://whisperbox.koyeb.app

# Cookie security flag for the refresh-token httpOnly cookie set by the
# Next.js auth proxy. Leave as `false` in development (HTTP localhost) and
# set to `true` in production (HTTPS only).
COOKIE_SECURE=false
